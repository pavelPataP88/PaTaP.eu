{
  "name": "patap-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Patap Lab static site served from this laptop through Cloudflare Tunnel.",
  "scripts": {
    "build": "node scripts/build.js",
    "auth:start": "node server/auth/server.js",
    "auth:bootstrap-owner": "node server/auth/bootstrap-owner.js",
    "auth:backup": "node server/auth/backup-db.js",
    "auth:restore": "node server/auth/restore-db.js",
    "test:auth": "node scripts/run-auth-tests.js",
    "test:client": "node --test tests/browser/client-storage.test.js",
    "test:driver-modules": "node --test tests/driver/module-loader.test.mjs tests/driver/chat-reactions.test.mjs tests/driver/road-reports.test.mjs tests/driver/map-enhancements.test.mjs",
    "test:config": "node --test tests/config/caddy-policy.test.js",
    "test:browser": "node scripts/run-browser-test.js",
    "audit:performance": "node scripts/audit-interface-performance.js",
    "test:platformos": "node scripts/test-platformos-runtime.js",
    "verify": "node scripts/verify.js && node scripts/test-platformos-runtime.js && npm run test:auth && npm run test:driver-modules && npm run test:client && npm run test:config"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "ws": "^8.21.0"
  }
}
